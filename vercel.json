{
  "version": 2,
  "build": {
    "env": {
      "PRISMA_GENERATE_DATAPROXY": "false",
      "PRISMA_SKIP_POSTINSTALL_GENERATE": "false",
      "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING": "1",
      "PRISMA_BINARY_CACHE_DIR": "/tmp",
      "NODE_ENV": "production"
    }
  },
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "functions": {
    "pages/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
